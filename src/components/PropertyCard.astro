---
// src/components/PropertyCard.astro
//
// Card rendering shared by the /homes grid (and, from 01-04, the homepage
// featured section). Address, price, and status are required schema fields
// (src/content.config.ts), so a card can never render data-less (UI-SPEC
// empty/E2). Any absent bed/bath/sqft renders "Call for details" for that
// field specifically -- D-10 -- converting a data gap into a phone prompt
// rather than a blank cell, a dash, or a zero.
//
// The card root carries `data-property-slug` -- a stable, machine-findable
// identifier -- so the /homes sort-determinism check can read the ordered
// sequence of cards straight out of built HTML instead of comparing whole
// files byte-for-byte (01-03-PLAN.md Task 2).
import type { CollectionEntry } from 'astro:content';
import StatusBadge from './StatusBadge.astro';
import BrandMark from './BrandMark.astro';

interface Props {
  entry: CollectionEntry<'properties'>;
}

const { entry } = Astro.props;
const { address, status, downPayment, monthlyPayment, beds, baths, sqft, photos } = entry.data;

const money = (n: number) => `$${n.toLocaleString('en-US')}`;
const detail = (n: number | undefined, unit: string) => (n === undefined ? 'Call for details' : `${n}${unit}`);

const cover = photos[0];
---

<a href={`/homes/${entry.id}`} class="property-card" data-property-slug={entry.id}>
  <div class="card-photo">
    {cover ? (
      <img
        src={cover}
        width="400"
        height="300"
        alt={`${address} -- exterior view`}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="card-photo-placeholder" role="img" aria-label="No photo available yet">
        <BrandMark variant="ink" size="sm" />
      </div>
    )}
    <StatusBadge status={status} class="card-badge" />
  </div>
  <div class="card-body">
    <p class="card-address">{address}</p>
    <p class="card-meta">
      {detail(beds, ' bed')} &middot; {detail(baths, ' bath')} &middot; {detail(sqft, ' sqft')}
    </p>
    <p class="card-price">
      <span class="price-figure">{money(downPayment)}</span> down &middot;
      <span class="price-figure">{money(monthlyPayment)}</span>/mo
    </p>
    <p class="card-price-note">Full terms in the written agreement.</p>
  </div>
</a>

<style>
  .property-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-cream-deep);
    border-radius: 8px;
    overflow: hidden;
    text-decoration: none;
    color: var(--color-ink);
  }

  .property-card:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }

  .card-photo {
    position: relative;
    aspect-ratio: 4 / 3;
    background-color: var(--color-cream-deep);
  }

  .card-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .card-photo-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* :global -- StatusBadge's own scoped .status-badge class lands with that
     component's own scope hash, not this file's; the layout position here
     (top-right of the photo) is this file's concern regardless. */
  :global(.card-badge) {
    position: absolute;
    top: 8px;
    right: 8px;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px;
  }

  .card-address {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.4;
    margin: 0;
    word-wrap: break-word;
  }

  .card-meta {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.4;
    margin: 0;
  }

  .card-price {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-price-gold);
    margin: 4px 0 0;
  }

  .price-figure {
    color: var(--color-price-gold);
  }

  .card-price-note {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 400;
    color: var(--color-ink);
    margin: 0;
  }
</style>
