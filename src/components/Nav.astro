---
// src/components/Nav.astro
//
// The 7-item primary nav (UI-SPEC ## UI Considerations, surface E4). Horizontal
// at >=768px with an accent active-indicator on the current page; below 768px
// it collapses into a hamburger drawer where all 7 items stack vertically with
// no truncation and no horizontal scroll. The drawer toggle is one of only two
// client-side JS islands this project has (SKELETON.md) -- a real <button>
// (not a checkbox+label hack, which is invisible to Tab and cannot trap focus
// or answer Escape) driving a small inline script: opens the drawer, traps
// Tab within the toggle plus the 7 links, closes on Escape, and returns focus
// to the toggle button on close (01-05-PLAN.md Task 1 -- the same contract
// gallery-lightbox.ts implements for the photo lightbox).
//
// Item set is fixed at build time -- UI-SPEC's empty/partial/zero-one-many
// rows for E4 all rest on that fact. Several destinations (About, Learn,
// Schedule, Contact) are created by later plans; the nav ships complete now
// because it is a layout concern, and plan 01-05 verifies no internal link
// 404s.
const items = [
  { href: '/', label: 'Home' },
  { href: '/homes', label: 'Browse Homes' },
  { href: '/how-it-works', label: 'How It Works' },
  { href: '/about', label: 'About' },
  { href: '/learn', label: 'Learn' },
  { href: '/schedule', label: 'Schedule a Showing' },
  { href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(href + '/');
}
---

<nav class="nav" aria-label="Primary" data-nav>
  <button
    type="button"
    class="nav-hamburger"
    data-nav-toggle
    aria-label="Open menu"
    aria-expanded="false"
    aria-controls="nav-drawer"
  >
    <span aria-hidden="true">&#9776;</span>
  </button>
  <ul class="nav-list" id="nav-drawer" data-nav-list>
    {items.map((item) => (
      <li>
        <a
          href={item.href}
          class="nav-link"
          aria-current={isActive(item.href) ? 'page' : undefined}
          data-active={isActive(item.href) ? 'true' : 'false'}
        >
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  // Keyboard contract (matches gallery-lightbox.ts's): Escape closes, focus
  // moves into the drawer's first link on open, Tab is trapped among the
  // toggle button plus the 7 links while open, and focus returns to the
  // toggle on close. Only meaningful below 768px, where the toggle is
  // visible and the list is hidden until opened -- at >=768px the toggle is
  // display:none (CSS below), so it is never focusable and this script's
  // open() path is never reached there.
  function initNav(root: HTMLElement): void {
    const toggle = root.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const list = root.querySelector<HTMLUListElement>('[data-nav-list]');
    if (!toggle || !list) return;

    const links = Array.from(list.querySelectorAll<HTMLAnchorElement>('a'));
    const focusable = [toggle, ...links];
    let isOpen = false;

    function onKeydown(event: KeyboardEvent): void {
      if (event.key === 'Escape') {
        event.preventDefault();
        close();
        return;
      }
      if (event.key === 'Tab') {
        const activeIndex = focusable.indexOf(document.activeElement as HTMLElement);
        event.preventDefault();
        const nextIndex = event.shiftKey
          ? (activeIndex - 1 + focusable.length) % focusable.length
          : (activeIndex + 1) % focusable.length;
        focusable[nextIndex]?.focus();
      }
    }

    function open(): void {
      isOpen = true;
      toggle!.setAttribute('aria-expanded', 'true');
      toggle!.setAttribute('aria-label', 'Close menu');
      list!.setAttribute('data-open', 'true');
      document.addEventListener('keydown', onKeydown);
      links[0]?.focus();
    }

    function close(options: { returnFocus?: boolean } = {}): void {
      const { returnFocus = true } = options;
      isOpen = false;
      toggle!.setAttribute('aria-expanded', 'false');
      toggle!.setAttribute('aria-label', 'Open menu');
      list!.removeAttribute('data-open');
      document.removeEventListener('keydown', onKeydown);
      if (returnFocus) toggle!.focus();
    }

    toggle.addEventListener('click', () => {
      if (isOpen) close({ returnFocus: false });
      else open();
    });

    // A resize past the desktop breakpoint hides the toggle and shows the
    // list unconditionally via CSS -- drop any lingering open/trap state so
    // a later resize back to mobile does not resume with a stale trap.
    const desktopQuery = window.matchMedia('(min-width: 768px)');
    desktopQuery.addEventListener('change', (event) => {
      if (event.matches && isOpen) close({ returnFocus: false });
    });
  }

  document.querySelectorAll<HTMLElement>('[data-nav]').forEach(initNav);
</script>

<style>
  .nav {
    position: relative;
  }

  .nav-hamburger {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    font-size: 24px;
    color: var(--color-ink);
  }

  .nav-hamburger:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }

  .nav-list {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.4;
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    white-space: nowrap;
  }

  .nav-link:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }

  .nav-link[data-active='true'] {
    border-bottom-color: var(--color-accent);
  }

  /* Below 768px: hide the horizontal list behind a hamburger drawer. All 7
     items stack vertically, full width, with no truncation and no
     horizontal scroll (UI-SPEC E4 overflow row). */
  @media (max-width: 767px) {
    .nav-hamburger {
      display: inline-flex;
    }

    .nav-list {
      display: none;
      position: absolute;
      top: 44px;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: var(--color-cream-deep);
      padding: 8px 0;
      z-index: 20;
    }

    .nav-list[data-open='true'] {
      display: flex;
    }

    .nav-link {
      width: 100%;
      padding: 8px 16px;
      white-space: normal;
    }
  }
</style>
