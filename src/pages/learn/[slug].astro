---
// src/pages/learn/[slug].astro
//
// Per-post route generated from the blog collection (EDU-04), following the
// same getStaticPaths + entry.id/entry.data.slug drift-assertion pattern as
// src/pages/homes/[slug].astro (SKELETON.md invariant 6) rather than
// re-deriving it. Renders title, date, optional cover image, and the prose
// body in a max-width container -- no clamping, no ellipsis, no truncation.
//
// ownerReviewed defaults to false until the owner completes the Phase 4
// review gate (D-15). While false, the page surfaces that state with a
// visible banner rather than presenting drafted copy as settled,
// owner-authored, or attorney-reviewed guidance.
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  return posts.map((entry) => {
    if (entry.id.includes('/')) {
      throw new Error(
        `Blog entry id "${entry.id}" contains a path separator, meaning its file sits in a ` +
          `subdirectory of src/content/blog/. The flat "*.md" loader glob is chosen specifically ` +
          `to exclude nesting -- this is not slug drift. Move the file to the top level of ` +
          `src/content/blog/.`,
      );
    }

    if (entry.id !== entry.data.slug) {
      throw new Error(
        `Blog post filename "src/content/blog/${entry.id}.md" (entry id "${entry.id}") does not ` +
          `equal its frontmatter slug "${entry.data.slug}". A post's permanent URL and the file ` +
          `that claims it must never drift apart -- fix the filename or the slug field so they match.`,
      );
    }

    return {
      params: { slug: entry.id },
      props: { entry },
    };
  });
}

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { title, date, coverImage, ownerReviewed } = entry.data;
const { Content } = await render(entry);

// timeZone: 'UTC' pins the rendered date to the frontmatter's calendar date
// regardless of the build machine's local timezone -- see learn/index.astro.
const dateFormatter = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<Layout title={title} description={`${title} -- a guide from Oak Homes.`}>
  <article class="post">
    <header class="post-header">
      {coverImage && (
        <img
          class="post-cover"
          src={coverImage}
          width="820"
          height="461"
          alt={`${title} cover`}
          loading="eager"
          decoding="async"
        />
      )}
      <h1>{title}</h1>
      <p class="post-date">{dateFormatter.format(date)}</p>
    </header>

    {!ownerReviewed && (
      <p class="review-banner">
        Awaiting owner review. This article is general information, not legal advice.
      </p>
    )}

    <div class="post-body">
      <Content />
    </div>
  </article>
</Layout>

<style>
  .post {
    max-width: 820px;
    margin: 0 auto;
    padding: 32px 24px 64px;
  }

  .post-cover {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
    margin-bottom: 16px;
  }

  .post-date {
    font-size: 14px;
    font-weight: 400;
    margin: 4px 0 0;
  }

  .review-banner {
    background-color: var(--color-pending);
    color: var(--color-ink);
    border-radius: 8px;
    padding: 10px 16px;
    font-size: 14px;
    font-weight: 600;
    margin: 24px 0;
  }

  .post-body {
    max-width: 70ch;
    line-height: 1.65;
    margin-top: 24px;
  }

  .post-body :global(h2) {
    margin-top: 32px;
  }

  .post-body :global(p) {
    margin: 12px 0 0;
  }

  .post-body :global(ul) {
    margin: 12px 0 0;
    padding-left: 20px;
  }

  .post-body :global(a) {
    text-decoration: underline;
  }
</style>
