---
// src/pages/how-it-works.astro
//
// Carries the phase's highest-consequence content: the land-contract copy
// the owner refined specifically to remove risky phrasing, ported
// character-for-character from docs/reference/Oak-Homes-How-It-Works.html
// (D-04, T-01-19). Do not paraphrase, modernize, tighten, or regenerate any
// of the transcribed copy below -- it must read as the same sentence as the
// source file, not a tightened one.
//
// This copy lives here, in a .astro page, and nowhere under src/content/ --
// a field that does not exist in a content collection is a field Phase 2's
// CMS structurally cannot expose for editing (DESIGN-03, T-01-21).
//
// The FAQ folded in below is fresh authoring (EDU-02): research verified by
// grep that neither source mockup contains any FAQ copy, so there was
// nothing to port. It is grounded in the transcribed wording above rather
// than composed independently, and it is drafted content awaiting the same
// Phase 4 owner-review gate as the seeded Learn post -- it is not presented
// as legal advice.
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import StepList from '../components/StepList.astro';

const settings = await getEntry('settings', 'main');
if (!settings) {
  throw new Error('how-it-works.astro: settings entry "main" not found in src/content/settings.json');
}
const { phone, phoneHref } = settings.data;

// The four-step process, transcribed verbatim (heading + body) from
// docs/reference/Oak-Homes-How-It-Works.html's <div class="steps"> block.
const steps = [
  {
    title: 'Find a home & reach out',
    body: "Browse our available homes and contact us about the one you like, or tell us what you're looking for and we'll match you.",
  },
  {
    title: "Let's talk",
    body: "We'll discuss the home, the terms, and what works for your situation.",
  },
  {
    title: 'Agree on terms',
    body: 'Down payment, monthly payment, and length — all written in plain language and agreed up front. No hidden steps.',
  },
  {
    title: 'Move in and settle in',
    body: 'You take possession of the home and make monthly payments toward full ownership under the contract.',
  },
];
---

<Layout
  title="How Owner Financing Works"
  description="A clear, step-by-step overview of how buying a home on a land contract works with Oak Homes."
>
  <section class="hero">
    <h1>How Owner Financing Works</h1>
    <p class="lead">
      We offer homes with owner financing, structured as a <strong>land contract</strong> (also
      called an agreement for deed) — a straightforward way to buy on contract, with clear terms,
      a down payment, and predictable monthly payments, all written plainly.
    </p>
  </section>

  <section class="process-section">
    <h2>The process, step by step</h2>
    <StepList steps={steps} />
  </section>

  <section class="meaning-section">
    <h2>What a land contract means</h2>
    <p data-copy="land-contract-meaning">
      With a land contract (agreement for deed), you take possession of the home and make
      monthly payments under a written agreement. You live in the home while you make your
      payments, and once the contract is completed as agreed, the deed and legal title transfer
      to the buyer. The full terms — including what happens if payments aren't made — are set
      out in the written agreement.
    </p>

    <div class="panel">
      <h2>What you'll typically need</h2>
      <ul class="need">
        <li><b>A down payment</b> — agreed up front, based on the home.</li>
        <li><b>Steady income</b> — to support the monthly payment.</li>
        <li><b>A commitment to long-term ownership.</b></li>
      </ul>
    </div>
  </section>

  <section class="faq-section">
    <h2>Frequently asked questions</h2>
    <p class="faq-intro">
      These answers are general information to help you get oriented, not legal advice. The
      written agreement for your home is always the source that governs your specific terms.
    </p>
    <dl class="faq-list">
      <div class="faq-item">
        <dt>Is this legitimate?</dt>
        <dd>
          Yes. Every home is sold on a written agreement with clear terms, agreed up front and
          put in plain language — the same document you can always refer back to.
        </dd>
      </div>
      <div class="faq-item">
        <dt>Do I get the deed?</dt>
        <dd>
          Once the contract is completed as agreed, the deed and legal title transfer to you.
          The full terms of when and how that happens are set out in the written agreement,
          which we'll walk through with you before you sign.
        </dd>
      </div>
      <div class="faq-item">
        <dt>What happens if I miss a payment?</dt>
        <dd>
          The written agreement sets out what happens if a payment is missed. If you're ever
          having trouble making a payment, reach out to us right away — we would rather talk
          with you early than let a missed payment become a bigger problem.
        </dd>
      </div>
    </dl>
  </section>

  <section class="cta">
    <h2>Ready to take the next step?</h2>
    <p>Call or message us and we'll walk you through every step.</p>
    <a class="contact-line" href={phoneHref}>{phone}</a>
    <div class="cta-buttons">
      <Button href={phoneHref} variant="accent">Call Us</Button>
      <Button href={`mailto:${settings.data.email}`} variant="ghost">Email Us</Button>
    </div>
    <p class="legal-note">
      This page is a general overview and not legal advice.
    </p>
  </section>
</Layout>

<style>
  .hero,
  .process-section,
  .meaning-section,
  .faq-section {
    max-width: 820px;
    margin: 0 auto;
    padding: 32px 24px;
  }

  .hero .lead {
    font-size: 19px;
    line-height: 1.5;
    max-width: 70ch;
  }

  .panel {
    background-color: var(--color-cream-deep);
    border-radius: 8px;
    padding: 20px 24px;
    margin-top: 24px;
  }

  .panel h2 {
    margin: 0;
  }

  .need {
    list-style: none;
    padding: 0;
    margin: 14px 0 0;
  }

  .need li {
    position: relative;
    padding: 6px 0 6px 30px;
  }

  .need li::before {
    content: '\2713';
    position: absolute;
    left: 0;
    top: 6px;
    color: var(--color-accent-hover);
    font-weight: 700;
    font-size: 18px;
  }

  .faq-intro {
    font-size: 14px;
    color: var(--color-ink);
    max-width: 70ch;
  }

  .faq-list {
    display: grid;
    gap: 20px;
    margin: 24px 0 0;
  }

  .faq-item dt {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 600;
    line-height: 1.2;
    margin: 0 0 6px;
  }

  .faq-item dd {
    margin: 0;
    font-size: 16px;
    line-height: 1.5;
    max-width: 70ch;
  }

  .cta {
    background-color: var(--color-ink);
    color: #fff;
    border-radius: 16px;
    padding: 34px 30px;
    text-align: center;
    max-width: 820px;
    margin: 0 auto 48px;
  }

  .cta h2 {
    color: #fff;
    margin: 0 0 8px;
  }

  .cta p {
    color: #e7e2d6;
    margin: 0 0 20px;
  }

  .contact-line {
    font-family: var(--font-display);
    font-size: 26px;
    color: var(--color-accent);
    font-weight: 700;
    text-decoration: none;
    display: inline-block;
    margin-bottom: 16px;
  }

  .cta-buttons {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .cta .btn-ghost {
    color: #fff;
    border-color: #fff;
  }

  .legal-note {
    margin: 20px 0 0;
    font-size: 12px;
    color: #a49e91;
  }
</style>
