---
// src/pages/privacy.astro
//
// Privacy Policy (COMPLIANCE-10DLC-01/02/03). Published so A2P 10DLC
// brand/campaign vetting can crawl a complete, accurate privacy policy --
// the single most common 10DLC rejection reason is a missing or inadequate
// privacy policy. This is the critical path to activating SMS on
// (217) 269-0003 through Zoho.
//
// Legal prose lives only in this file and src/data/legal.ts, never under
// src/content/ and never as a CMS field -- the same DESIGN-03 rule already
// protecting the Equal Housing and land-contract wording in Layout.astro
// and how-it-works.astro. The assistant must not be able to edit this copy
// from the admin panel.
//
// This is standard-practice compliance copy drafted to what carrier and TCR
// vetting look for. It is not legal advice; it belongs in the attorney
// review already pending on the land-contract wording.
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { LEGAL_ENTITY_NAME, BUSINESS_ADDRESS, LEGAL_EFFECTIVE_DATE } from '../data/legal';

const settings = await getEntry('settings', 'main');
if (!settings) {
  throw new Error('privacy.astro: settings entry "main" not found in src/content/settings.json');
}
const { phone, phoneHref, email } = settings.data;
---

<Layout title="Privacy Policy" description="How Oak Homes collects, uses, and protects your information, including text messaging consent.">
  <section class="legal">
    <h1>Privacy Policy</h1>
    <p class="lead">Effective date: {LEGAL_EFFECTIVE_DATE}</p>

    <h2>Who we are</h2>
    <p>
      Oak Homes is the business name under which we sell homes in Flint, Michigan on owner
      financing / land contract. The operating legal entity is {LEGAL_ENTITY_NAME}. Our mailing
      address is {BUSINESS_ADDRESS}. You can reach us by phone at <a href={phoneHref}>{phone}</a>{' '}
      or by email at <a href={`mailto:${email}`}>{email}</a>. Our website is ownwithoak.com.
    </p>

    <h2>Information we collect</h2>
    <p>When you contact us, we may collect:</p>
    <ul>
      <li>Your name</li>
      <li>Your phone number</li>
      <li>Your email address</li>
      <li>The content of any message or inquiry you send us by phone, text, or email</li>
      <li>The property you inquired about</li>
    </ul>
    <p>
      This site does not use analytics, advertising, or tracking cookies, and we do not collect
      information from visitors who simply browse the site without contacting us.
    </p>

    <h2>How we use your information</h2>
    <p>
      We use the information you provide to respond to inquiries about homes, to schedule
      showings, to discuss owner-financing terms, and to send text messages about those things
      when you have given us a phone number for that purpose.
    </p>

    <h2>Text messages and mobile information</h2>
    <p>
      If you provide your phone number and consent to receive text messages from us, we may text
      you about your inquiry, a showing, or owner-financing terms.
    </p>
    <p>
      No mobile information will be sold or shared with third parties or affiliates for marketing or promotional purposes. All the above categories exclude text messaging originator opt-in data and consent; this information will not be shared with any third parties.
    </p>
    <p>
      See our <a href="/sms-terms">SMS Terms</a> for message frequency, message and data rate
      information, and how to opt out.
    </p>

    <h2>Service providers</h2>
    <p>
      We use a small number of service providers to operate this site and follow up with you:
    </p>
    <ul>
      <li>Zoho CRM (Zoho Corporation) stores your contact details and inquiry content so Oak Homes can follow up with you.</li>
      <li>Netlify hosts this website and keeps standard server access logs.</li>
    </ul>
    <p>
      These providers process information on Oak Homes' behalf. Oak Homes does not sell personal
      information to anyone.
    </p>

    <h2>How long we keep information</h2>
    <p>
      We keep your information as long as needed to respond to your inquiry and to keep records
      of a transaction, then delete it on request.
    </p>

    <h2>Requesting deletion of your information</h2>
    <p>
      You may request a copy or deletion of your information at any time by calling
      <a href={phoneHref}>{phone}</a> or emailing <a href={`mailto:${email}`}>{email}</a>. We will
      respond within 30 days. You can also opt out of text messages at any time by replying STOP.
    </p>

    <h2>Children's privacy</h2>
    <p>
      This site is not directed to children under 13, and we do not knowingly collect information
      from them.
    </p>

    <h2>Changes to this policy</h2>
    <p>
      If we change this policy, we will post the change on this page with a new effective date.
    </p>

    <h2>Contact us</h2>
    <p>
      Oak Homes<br />
      {BUSINESS_ADDRESS}<br />
      Phone: <a href={phoneHref}>{phone}</a><br />
      Email: <a href={`mailto:${email}`}>{email}</a>
    </p>
  </section>
</Layout>

<style>
  .legal {
    max-width: 820px;
    margin: 0 auto;
    padding: 32px 24px 64px;
  }

  .legal .lead {
    font-size: 16px;
    line-height: 1.5;
    max-width: 70ch;
    margin: 0 0 16px;
  }

  .legal h2 {
    margin-top: 24px;
  }

  .legal p {
    margin: 0 0 12px;
    max-width: 70ch;
  }

  .legal ul {
    margin: 0 0 12px;
    padding-left: 24px;
    max-width: 70ch;
  }
</style>
