---
// src/pages/sms-terms.astro
//
// SMS Terms (COMPLIANCE-10DLC-01/02/03). Carries the CTIA/carrier-expected
// disclosures A2P 10DLC brand/campaign vetting looks for: sender identity
// and message type, message frequency, message-and-data-rates, STOP to opt
// out, HELP for help, and that consent is not a condition of purchase. This
// is the critical path to activating SMS on (217) 269-0003 through Zoho.
//
// Legal prose lives only in this file and src/data/legal.ts, never under
// src/content/ and never as a CMS field -- the same DESIGN-03 rule already
// protecting the Equal Housing and land-contract wording in Layout.astro
// and how-it-works.astro. The assistant must not be able to edit this copy
// from the admin panel.
//
// This is standard-practice compliance copy drafted to what carrier and TCR
// vetting look for. It is not legal advice; it belongs in the attorney
// review already pending on the land-contract wording.
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { LEGAL_ENTITY_NAME, LEGAL_EFFECTIVE_DATE } from '../data/legal';

const settings = await getEntry('settings', 'main');
if (!settings) {
  throw new Error('sms-terms.astro: settings entry "main" not found in src/content/settings.json');
}
const { phone, phoneHref, email } = settings.data;
---

<Layout title="SMS Terms" description="Terms for text messages from Oak Homes, including opt-out, help, and message frequency information.">
  <section class="legal">
    <h1>SMS Terms</h1>
    <p class="lead">Effective date: {LEGAL_EFFECTIVE_DATE}</p>

    <h2>About our messages</h2>
    <p>
      Oak Homes (operating as {LEGAL_ENTITY_NAME}) sends text messages about property inquiries,
      showing scheduling, and questions about owner-financing terms. Messages come from{' '}
      <a href={phoneHref}>{phone}</a>.
    </p>

    <h2>How you opt in</h2>
    <p>
      You consent to receive text messages from Oak Homes by texting us, by giving us your phone
      number when you call or speak with us in person, or by providing your phone number when you
      contact us about a home.
    </p>

    <h2>Message frequency</h2>
    <p>Message frequency varies.</p>

    <h2>Cost</h2>
    <p>Message and data rates may apply.</p>

    <h2>How to stop messages</h2>
    <p>
      You can opt out at any time by replying STOP to any message from us. After replying STOP
      you will receive one confirmation message and no further messages. You can opt back in at
      any time by texting START or by contacting us.
    </p>

    <h2>How to get help</h2>
    <p>
      Reply HELP to any message from us for help. You can also reach us at
      <a href={phoneHref}>{phone}</a> or <a href={`mailto:${email}`}>{email}</a>.
    </p>

    <h2>Consent is not required to buy</h2>
    <p>Consent to receive text messages from Oak Homes is not a condition of any purchase.</p>

    <h2>Carrier notice</h2>
    <p>Carriers are not liable for delayed or undelivered messages.</p>

    <h2>Privacy</h2>
    <p>
      No mobile information will be sold or shared with third parties or affiliates for marketing
      or promotional purposes. See our <a href="/privacy">Privacy Policy</a> for details.
    </p>
  </section>
</Layout>

<style>
  .legal {
    max-width: 820px;
    margin: 0 auto;
    padding: 32px 24px 64px;
  }

  .legal .lead {
    font-size: 16px;
    line-height: 1.5;
    max-width: 70ch;
    margin: 0 0 16px;
  }

  .legal h2 {
    margin-top: 24px;
  }

  .legal p {
    margin: 0 0 12px;
    max-width: 70ch;
  }

  .legal ul {
    margin: 0 0 12px;
    padding-left: 24px;
    max-width: 70ch;
  }
</style>
