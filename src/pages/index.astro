---
// src/pages/index.astro
//
// Homepage: settings-driven intro + a Browse Homes CTA. The 3-step overview
// and featured-homes section arrive in plan 01-04 -- this is deliberately
// minimal, replacing plan 01-02 Task 2's scaffold placeholder.
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';

const settings = await getEntry('settings', 'main');
if (!settings) {
  throw new Error('index.astro: settings entry "main" not found in src/content/settings.json');
}
const { homepageIntro } = settings.data;
---

<Layout title="A Path to Homeownership">
  <section class="hero">
    <h1>A Path to Homeownership</h1>
    <p>{homepageIntro}</p>
    <Button href="/homes">Browse Homes</Button>
  </section>
</Layout>

<style>
  .hero {
    max-width: 64ch;
    margin: 0 auto;
    padding: 64px 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
</style>
