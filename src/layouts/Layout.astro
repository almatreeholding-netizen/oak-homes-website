---
// src/layouts/Layout.astro
//
// The single shared layout every page renders through (SKELETON.md
// invariant 3, DESIGN-02/DESIGN-03). A page template cannot ship without the
// header, phone, footer, or the verbatim Equal Housing line, because all four
// live only here.
//
import { getEntry } from 'astro:content';
import Nav from '../components/Nav.astro';
import BrandMark from '../components/BrandMark.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Oak Homes -- owner-financed homes in Flint, MI. From Rent to Roots.' } = Astro.props;

const settings = await getEntry('settings', 'main');
if (!settings) {
  throw new Error('Layout.astro: settings entry "main" not found in src/content/settings.json');
}
const { phone, phoneHref, email, social } = settings.data;

// Transcribed character-for-character from
// docs/specs/2026-08-28-oak-homes-website-design.md section 6. Do not
// paraphrase, summarize, or "improve" this wording -- it is legally refined
// (T-01-05). It must never become a content-collection field (DESIGN-03):
// no file under src/content/ may contain this string.
const equalHousingLine =
  'Equal Housing Opportunity. Owner financing is subject to a written agreement; this is not a commitment to lend or an offer of credit.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <!--
      Favicon set exported by scripts/build-brand-assets.mjs (01-02 Task 4).
      This is the one documented exemption from "only BrandMark.astro names a
      brand path": a favicon is declared with link elements in the document
      head, markup BrandMark.astro cannot emit because it renders an image
      element in the body. Confined to rel="icon" / "apple-touch-icon" -- see
      BrandMark.astro for every other brand-image reference in this project.
    -->
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/brand/apple-touch-icon-180.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/brand/android-chrome-192.png" />
    <title>{title} | Oak Homes</title>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <header class="site-header">
      <a href="/" class="brand-mark">
        <BrandMark variant="ink" alt="Oak Homes — From Rent to Roots" />
      </a>
      <Nav />
      <a href={phoneHref} class="header-phone">{phone}</a>
    </header>

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <BrandMark variant="light" class="footer-mark" />
      <div class="footer-contact">
        <a href={phoneHref}>{phone}</a>
        <a href={`mailto:${email}`}>{email}</a>
        {social.facebook && <a href={social.facebook} rel="noopener">Facebook</a>}
      </div>
      <nav class="footer-nav" aria-label="Footer">
        <a href="/homes">Browse Homes</a>
        <a href="/how-it-works">How It Works</a>
        <a href="/about">About</a>
        <a href="/learn">Learn</a>
        <a href="/schedule">Schedule a Showing</a>
        <a href="/contact">Contact</a>
        <a href="/privacy">Privacy Policy</a>
        <a href="/sms-terms">SMS Terms</a>
      </nav>
      <p class="equal-housing">{equalHousingLine}</p>
    </footer>

    <!-- integrations-slot: the one place site-wide scripts and widgets are
         added (design spec section 9). Renders nothing in Phase 1. -->
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
  }

  body {
    background-color: var(--color-cream);
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.5;
  }

  h1,
  h2 {
    font-family: var(--font-display);
    font-weight: 600;
    margin: 0;
  }

  h1 {
    font-size: 36px;
    line-height: 1.15;
  }

  h2 {
    font-size: 24px;
    line-height: 1.2;
  }

  a {
    color: inherit;
  }

  /* Uniform focus-visible ring across every plain-text link that does not
     already declare its own (Button.astro, PropertyCard.astro, and the
     Gallery's own controls declare their own scoped :focus-visible rules;
     this covers the header/footer/nav links that share this global style
     block instead). */
  a:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }

  /* main is the skip-link's target; tabindex="-1" makes it programmatically
     focusable without adding it to the normal Tab order, and this rule
     suppresses the default focus ring browsers would otherwise draw around
     the whole content region when focus lands there. */
  main:focus-visible {
    outline: none;
  }
</style>

<style>
  /* First focusable element on every page (DESIGN-04). Off-screen until
     focused, then pinned to the top-left corner above everything else so a
     keyboard user can see it land. */
  .skip-link {
    position: absolute;
    top: -48px;
    left: 8px;
    z-index: 200;
    padding: 8px 16px;
    background-color: var(--color-cream);
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    border-radius: 4px;
    transition: top 0.1s ease-in-out;
  }

  .skip-link:focus-visible {
    top: 8px;
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 8px 24px;
    background-color: var(--color-cream-deep);
  }

  .brand-mark {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }

  /* :global -- .footer-mark lands on BrandMark.astro's own <picture>
     element, which carries that child component's scope hash rather than
     this file's. An unscoped selector here would never match it. */
  :global(.footer-mark) {
    display: block;
    margin-bottom: 8px;
  }

  .header-phone {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  main {
    min-height: 60vh;
  }

  .site-footer {
    background-color: var(--color-cream-deep);
    padding: 32px 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer-contact,
  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    font-size: 14px;
  }

  .footer-contact a,
  .footer-nav a {
    text-decoration: none;
  }

  .equal-housing {
    font-size: 14px;
    font-weight: 400;
    max-width: 64ch;
    margin: 0;
  }
</style>
