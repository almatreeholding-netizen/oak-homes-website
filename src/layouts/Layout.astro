---
// src/layouts/Layout.astro
//
// The single shared layout every page renders through (SKELETON.md
// invariant 3, DESIGN-02/DESIGN-03). A page template cannot ship without the
// header, phone, footer, or the verbatim Equal Housing line, because all four
// live only here.
//
// Header brand mark: this task ships the minimum real mark needed to prove
// the tracer end to end -- a text logotype link to "/". Plan 01-02 Task 4
// introduces BrandMark.astro (ink/light/circle variants, the exported raster
// assets under public/brand/, and the header mark's tagline alt text) and
// replaces this text mark with that component. Do not add BrandMark.astro or
// public/brand/ here -- that is Task 4's scope.
import { getEntry } from 'astro:content';
import Nav from '../components/Nav.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Oak Homes -- owner-financed homes in Flint, MI. From Rent to Roots.' } = Astro.props;

const settings = await getEntry('settings', 'main');
if (!settings) {
  throw new Error('Layout.astro: settings entry "main" not found in src/content/settings.json');
}
const { phone, phoneHref, email, social } = settings.data;

// Transcribed character-for-character from
// docs/specs/2026-08-28-oak-homes-website-design.md section 6. Do not
// paraphrase, summarize, or "improve" this wording -- it is legally refined
// (T-01-05). It must never become a content-collection field (DESIGN-03):
// no file under src/content/ may contain this string.
const equalHousingLine =
  'Equal Housing Opportunity. Owner financing is subject to a written agreement; this is not a commitment to lend or an offer of credit.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title} | Oak Homes</title>
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="brand-mark">Oak Homes</a>
      <Nav />
      <a href={phoneHref} class="header-phone">{phone}</a>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-contact">
        <a href={phoneHref}>{phone}</a>
        <a href={`mailto:${email}`}>{email}</a>
        {social.facebook && <a href={social.facebook} rel="noopener">Facebook</a>}
      </div>
      <nav class="footer-nav" aria-label="Footer">
        <a href="/homes">Browse Homes</a>
        <a href="/how-it-works">How It Works</a>
        <a href="/about">About</a>
        <a href="/learn">Learn</a>
        <a href="/schedule">Schedule a Showing</a>
        <a href="/contact">Contact</a>
      </nav>
      <p class="equal-housing">{equalHousingLine}</p>
    </footer>

    <!-- integrations-slot: the one place site-wide scripts and widgets are
         added (design spec section 9). Renders nothing in Phase 1. -->
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
  }

  body {
    background-color: var(--color-cream);
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.5;
  }

  h1,
  h2 {
    font-family: var(--font-display);
    font-weight: 600;
    margin: 0;
  }

  h1 {
    font-size: 36px;
    line-height: 1.15;
  }

  h2 {
    font-size: 24px;
    line-height: 1.2;
  }

  a {
    color: inherit;
  }
</style>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 8px 24px;
    background-color: var(--color-cream-deep);
  }

  .brand-mark {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 600;
    text-decoration: none;
    color: var(--color-ink);
  }

  .header-phone {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  main {
    min-height: 60vh;
  }

  .site-footer {
    background-color: var(--color-cream-deep);
    padding: 32px 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer-contact,
  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    font-size: 14px;
  }

  .footer-contact a,
  .footer-nav a {
    text-decoration: none;
  }

  .equal-housing {
    font-size: 14px;
    font-weight: 400;
    max-width: 64ch;
    margin: 0;
  }
</style>
